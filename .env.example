# Copy this file to .env and paste keys below. Never commit .env.
# rea-video reads .env in the repo root, or the file you pass with --env-file.

# Analysis. When this is set and REA_VLM_* is not, shots are read by Gemini 3.1 Pro Preview.
# Override the model with REA_GEMINI_MODEL. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Video and stills. With GEMINI_API_KEY also set, remake plans default to
# Seedance 2.5 (video) and GPT Image 2 (keyframes and stills) on Kie.
# https://kie.ai   API docs: https://docs.kie.ai
KIE_API_KEY=

# Optional fallback for `rea-video generate` when KIE_API_KEY is not set.
# Same Seedance 2.5 path, billed on Zurelay. It does not change the default plan:
# without both keys above, plans stay on MiniMax H3. https://zurelay.com
ZURELAY_API_KEY=

# Another multimodal model (Doubao, Qwen-VL, GPT-4o, ...). When all three are set,
# this endpoint is used instead of Gemini.
# REA_VLM_BASE_URL=https://.../v1
# REA_VLM_API_KEY=
# REA_VLM_MODEL=
